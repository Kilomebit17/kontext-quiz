# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public URL of the web app (used for magic links, QR codes, CORS)
WEB_ORIGIN=http://localhost:3000
# Public URL of the API (used for OAuth callbacks)
API_ORIGIN=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgres://kontext:kontext@localhost:5432/kontext

# Redis (optional in dev; required for multi-instance scaling)
REDIS_URL=redis://localhost:6379

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string

# Email (magic links). If SMTP_HOST is empty, links are logged to stdout (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kontext Quiz <no-reply@kontextquiz.app>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limits (per IP per minute)
JOIN_RATE_LIMIT_PER_MIN=300
PIN_GUESS_LIMIT_PER_MIN=10

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# ---- Web (Vite; must be prefixed with VITE_) ----
VITE_API_URL=http://localhost:4000
VITE_SENTRY_DSN=
