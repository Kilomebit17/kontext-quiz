# Copy to `.env` next to docker-compose.yml and fill in.

# Public hostname of the site. Without your own domain use sslip.io, which maps
# any IP to a hostname automatically: for a server at 203.0.113.10 write
#   SITE_ADDRESS=203.0.113.10.sslip.io
# Caddy obtains a Let's Encrypt certificate for it (ports 80 and 443 must be reachable).
SITE_ADDRESS=

# Random secrets — generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Optional
# IMAGE_TAG=latest
# LOG_LEVEL=info
